{
  "app-id": "org.openbf2.Setup",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "OpenBF2",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--env=QT_QPA_PLATFORMTHEME=xdgdesktopportal"
  ],
  "modules": [
    {
      "name": "openbf2-portable",
      "buildsystem": "simple",
      "build-commands": ["cp -a bin lib share /app/"],
      "sources": [{"type": "dir", "path": "portable"}]
    }
  ]
}
